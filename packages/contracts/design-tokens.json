  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": { "primary": "#1267B2", "navy": "#102C46", "surface": "#F5F9FC" },
    "action": { "safety": "#E64255", "success": "#18A879" },
